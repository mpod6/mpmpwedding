{
  "name": "mpmp-wedding-nav",
  "version": "1.0.0",
  "description": "Static top navigation masthead for the wedding site — names wordmark plus page links. No client-side JS.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "quartz": {
    "name": "wedding-nav",
    "displayName": "Wedding Nav",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "WeddingNav": {
        "displayName": "Wedding Nav",
        "defaultPosition": "beforeBody",
        "defaultPriority": 1
      }
    }
  }
}
